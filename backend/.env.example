# Examples only. Copy explicitly; the application never auto-loads .env.
Y3_ENVIRONMENT=development
Y3_DATABASE_URL=postgresql+psycopg://y3management_dev:local-example-only@127.0.0.1:55432/y3management_dev
Y3_LOG_LEVEL=INFO
Y3_DB_CONNECT_TIMEOUT_SECONDS=3
Y3_DB_POOL_TIMEOUT_SECONDS=2
Y3_DB_STATEMENT_TIMEOUT_MS=2000
Y3_READINESS_TIMEOUT_SECONDS=4
# Integration tests ignore Y3_DATABASE_URL and require this separate opt-in.
Y3_TEST_DATABASE_URL=postgresql+psycopg://y3management_test:local-test-example-only@127.0.0.1:55433/y3management_test
