{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "safe": {
      "format": "%(levelname)s %(name)s %(message)s"
    }
  },
  "handlers": {
    "console": {
      "class": "logging.StreamHandler",
      "formatter": "safe",
      "stream": "ext://sys.stderr"
    }
  },
  "loggers": {
    "y3management": {
      "handlers": [
        "console"
      ],
      "level": "INFO",
      "propagate": false
    },
    "uvicorn.error": {
      "handlers": [
        "console"
      ],
      "level": "INFO",
      "propagate": false
    },
    "uvicorn.access": {
      "handlers": [],
      "level": "CRITICAL",
      "propagate": false
    },
    "sqlalchemy": {
      "handlers": [],
      "level": "CRITICAL",
      "propagate": false
    },
    "psycopg": {
      "handlers": [],
      "level": "CRITICAL",
      "propagate": false
    }
  },
  "root": {
    "handlers": [
      "console"
    ],
    "level": "WARNING"
  }
}
